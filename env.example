# Environment variables for djidali-front Vite app
# Copy this file to .env for local development

# API Base URL - defaults to production if not set
VITE_API_BASE_URL=http://localhost:3000/api

# Image Base URL - for resolving uploaded assets
VITE_IMAGE_BASE_URL=http://localhost:3000

# Production values (used when .env is not present):
# VITE_API_BASE_URL=https://demo-api.djidali.uz/api
# VITE_IMAGE_BASE_URL=https://demo-api.djidali.uz




